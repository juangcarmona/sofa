@page
@model SoFa.Web.Pages.IndexModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SoFa · Attention</title>
    <link rel="stylesheet" href="~/site.css" />
</head>
<body>
<main>
    <header><div><p class="eyebrow">SoFa · My software factory</p><h1>Needs my attention</h1>
        <p>Five repositories. Evidence to investigate. Decisions stay with you.</p></div>
        <form method="post" asp-page-handler="Refresh"><button type="submit">Refresh attention</button></form>
    </header>
    @if (Model.Error is not null) { <p role="alert" class="notice">@Model.Error</p> }
    @if (Model.Refreshing) { <p role="status" class="notice">A refresh is running. This page shows the last completed snapshot; reload to see the result.</p> }
    @if (Model.Snapshot is not { } snapshot)
    {
        <section><h2>Ready when you are</h2><p>No collection has occurred in this application session. Refresh to read the five repositories.</p></section>
    }
    else
    {
        <p class="timestamp">Collected <time>@snapshot.StartedAt.ToString("u")</time> – <time>@snapshot.CompletedAt.ToString("u")</time>. This is a snapshot, not a live feed.</p>
        @foreach (var repository in snapshot.Repositories)
        {
            <section aria-label="@repository.Repository">
                <h2>@repository.Repository</h2>
                @foreach (var category in repository.Categories)
                {
                    <article>
                        <h3>@category.Category <span class="badge @category.Coverage.ToString().ToLowerInvariant()">@category.Coverage</span></h3>
                        <p class="muted">@category.Detail</p>
                        @if (category.Findings.Count == 0)
                        {
                            <p>@(category.Coverage == Coverage.Complete ? "No matching attention items in the inspected evidence." : "No matching findings available. Coverage above limits what can be concluded.")</p>
                        }
                        @foreach (var finding in category.Findings)
                        {
                            var item = finding.Evidence;
                            <div class="finding"><strong>@finding.Reason</strong><p>
                                @if (SoFa.Web.Pages.IndexModel.SafeLink(item.Url) is { } link) { <a href="@link" rel="noreferrer">@item.Title ↗</a> }
                                else { <span>@item.Title — no safe GitHub evidence link available</span> }
                            </p><p class="muted">Source @item.Id · @item.State · <time>@item.EvidenceTime.ToString("u")</time></p>
                            @if (item.Revision.Length > 0) { <p class="revision">Revision @item.Revision</p> }
                            </div>
                        }
                        @if (category.Observations.Count > 0 && category.Category is Category.Checks or Category.Releases)
                        {
                            <details><summary>Inspected source conclusions (@category.Observations.Count)</summary>
                                <ul>@foreach (var observation in category.Observations) { <li>@observation.Title — @observation.State · @observation.EvidenceTime.ToString("u")</li> }</ul>
                            </details>
                        }
                    </article>
                }
            </section>
        }
    }
    <footer>Observation only. Follow evidence links to review, investigate, or act in GitHub.</footer>
</main>
</body>
</html>
