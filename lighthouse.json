{
  "$schema": "./node_modules/@juangcarmona/lighthouse/assets/schemas/lighthouse-manifest.schema.json",
  "schemaVersion": 1,
  "baseline": "0.1.0",
  "product": "sofa",
  "profiles": [
    "dotnet-backend"
  ],
  "integrations": {
    "productShape": "0.23.0",
    "arcShape": "0.4.0"
  },
  "packages": {
    "sdlc": {
      "name": "@juangcarmona/lighthouse-sdlc",
      "version": "0.21.4"
    }
  },
  "managed": [
    "LIGHTHOUSE.md",
    "scripts/lighthouse-guard.mjs",
    ".husky/commit-msg",
    ".husky/pre-push",
    ".github/workflows/lighthouse.yml",
    ".lighthouse/sdlc.json",
    ".agents/skills/lighthouse-init/SKILL.md",
    ".lighthouse/upgrade.json",
    ".lighthouse/commands.json"
  ],
  "repository": {
    "layout": [
      "src",
      "docs",
      "infra",
      "scripts"
    ],
    "publicSite": {
      "enabled": true
    },
    "conventions": {
      "commits": "conventional",
      "branchPattern": "^(?:(feat|fix|docs|refactor|test|chore|build|ci|perf|revert)/[1-9]\\d*-[a-z0-9]+(?:-[a-z0-9]+)*|lighthouse/(?:propose|implement)-[1-9][0-9]*-[a-f0-9]{12}|dependabot/(?:npm_and_yarn|github_actions)/[a-zA-Z0-9][a-zA-Z0-9._-]*(?:/[a-zA-Z0-9][a-zA-Z0-9._-]*)*)$"
    }
  },
  "application": {
    "shape": "full-stack",
    "stacks": [
      "dotnet"
    ]
  }
}
